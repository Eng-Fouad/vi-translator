{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VI Translator",
  "version": "0.1.0",
  "identifier": "com.vitranslator.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VI Translator",
        "width": 1400,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
